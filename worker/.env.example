# Worker environment variables and secrets (Phase 8).
#
# SAFE to commit: only placeholders and documentation live here.
# NEVER commit real secret values. Set production values with:
#   wrangler secret put VAPID_PUBLIC_KEY
#   wrangler secret put VAPID_PRIVATE_JWK
#   wrangler secret put VAPID_SUBJECT
#
# VAPID keypair generation (run once, keep the private JWK secret):
#   npx web-push generate-vapid-keys --json
# ...or any RFC8292 P-256 generator. Store the PRIVATE JWK object as the
# VAPID_PRIVATE_JWK secret; the base64url public key goes in
# VAPID_PUBLIC_KEY (safe to expose via GET /api/push/public-key).

# Base64url-encoded P-256 public key (public; also served to browsers).
VAPID_PUBLIC_KEY = "REPLACE_WITH_VAPID_PUBLIC_KEY"

# Contact address embedded in VAPID JWT claims (e.g. mailto:admin@hawkbucks.com).
VAPID_SUBJECT = "mailto:admin@hawkbucks.com"

# >>> SECRET — set via `wrangler secret put VAPID_PRIVATE_JWK`, never here. <<<
# VAPID_PRIVATE_JWK = {"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
