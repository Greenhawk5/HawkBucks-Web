{
  "name": "hawkbucks",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "HAWKBUCKS_API",
      "service": "hawkbucks-web"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hawkbucks-data",
      "database_id": "ef9831f2-2d9c-4c11-a49e-c1935ae5edb7",
      "migrations_dir": "../worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "hawkbucks-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PUBLIC_CONTENT_CACHE",
      "id": "19e23aa284f648de8acec40e5f963e35"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://media.hawkbucks.com",
    "PUBLIC_DATA_CACHE_MAX_AGE_SECONDS": "600",
    "PUBLIC_RPC_BROWSER_MAX_AGE_SECONDS": "60"
  }
}

