{
  "name": "hawkbucks",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "HAWKBUCKS_API",
      "service": "hawkbucks-web"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "hawkbucks-media"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://media.hawkbucks.com"
  }
}

