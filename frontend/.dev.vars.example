# LOCAL-ONLY CMS admin bootstrap secrets for `npm run dev:cloudflare`.
# Wrangler `pages dev` loads .dev.vars automatically from frontend/
# (.dev.vars is gitignored — NEVER commit real values).
#
# 1. Generate a PBKDF2 envelope for your chosen local password:
#      node scripts/make-cms-admin-hash.mjs "your-local-password"
# 2. Paste the output as CMS_ADMIN_PASSWORD_HASH below.
# 3. `ensureBootstrapAdmin()` creates the first admin from these values ONLY
#    when the LOCAL cms_users table is empty; afterwards they are ignored.
#    There is no default password — login fails closed without these.
CMS_ADMIN_USERNAME=local-admin
CMS_ADMIN_PASSWORD_HASH=pbkdf2$100000$REPLACE_WITH_SALT$REPLACE_WITH_HASH
#
# Wave 1 — Cloudflare Turnstile bot protection for the CMS login (OPTIONAL
# locally). Both lines absent = Turnstile off, password-only login (local dev
# convenience — NEVER the production posture). Set BOTH to enforce:
#   1. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
#      (managed or non-interactive mode both work; invisible needs no UI room).
#   2. Paste the widget's SITE key below (public — safe in this gitignored file).
#   3. Store the SECRET with `wrangler secret put CMS_TURNSTILE_SECRET` for
#      production; locally, paste it below. NEVER commit the real secret.
# Exactly one set = login fails closed (generic 401) until fixed.
#CMS_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#CMS_TURNSTILE_SECRET=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
